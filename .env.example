# Copy to .env and fill in for a real deployment. Never commit the real .env file.

# The public address of the site. This is what gets printed inside the QR codes.
BASE_URL=https://your-site.example

# A long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Mail server. Leave SMTP_HOST empty to stay in test mode (emails shown at /dev/outbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CarNote <no-reply@your-site.example>

# Set to 1 when hosted behind a proxy (most hosting platforms).
TRUST_PROXY=1
